VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional; defaults to http://localhost:8000 in development
VITE_API_BASE_URL=http://localhost:8000
# Where event data comes from:
#   "api"  - every screen (supervisor and peer educator) uses the backend and Supabase.
#   "demo" - sample data saved only in this browser, for trying the UI without a backend.
VITE_EVENTS_DATA_SOURCE=api

# Only matters when VITE_EVENTS_DATA_SOURCE isn't "api": "api" here puts just the
# supervisor dashboard on the backend, while peer educator screens stay on demo data.
VITE_SUPERVISOR_DATA_SOURCE=api
